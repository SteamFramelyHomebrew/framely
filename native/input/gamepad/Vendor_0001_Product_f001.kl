# Framely's isolated virtual Android gamepad; Xbox-compatible scan codes.
key 304 BUTTON_A
key 305 BUTTON_B
key 307 BUTTON_X
key 308 BUTTON_Y
key 310 BUTTON_L1
key 311 BUTTON_R1
key 312 BUTTON_L2
key 313 BUTTON_R2
key 314 BUTTON_SELECT
key 315 BUTTON_START
key 317 BUTTON_THUMBL
key 318 BUTTON_THUMBR
axis 0x00 X flat 1024
axis 0x01 Y flat 1024
axis 0x03 Z flat 1024
axis 0x04 RZ flat 1024
axis 0x02 LTRIGGER
axis 0x05 RTRIGGER
axis 0x10 HAT_X
axis 0x11 HAT_Y
